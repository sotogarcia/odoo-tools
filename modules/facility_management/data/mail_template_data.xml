<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="0">

  <record id="mail_notify_reservation_requests" model="mail.template">
    <field name="name">Reservation requests awaiting confirmation</field>
    <field name="subject">
      {{ object.name }} - Reservation requests awaiting confirmation
    </field>
    <field name="email_from">
      {{ object.company_id.email_formatted or user.email_formatted }}
    </field>
    <field name="email_to">
      {{ object.manager_id.email_formatted or '' }}
    </field>
    <field name="auto_delete" eval="True"/>
    <field name="model_id" ref="facility_management.model_facility_complex"/>
    <field name="body_html" type="html">
      <t t-call="facility_management.email_layout">

        <t t-set="title" t-value="''"/>
        <t t-set="subtitle"
          t-value="'Reservation requests awaiting confirmation'"/>
        <t t-set="logo_src"
          t-value="'/logo.png?company=%s' % object.company_id.id"/>

        <t t-set="body_html">
          <t t-call="facility_management.email_body_reservation_requests"/>
        </t>

      </t>
    </field>
  </record>

</odoo>
