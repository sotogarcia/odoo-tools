<?xml version="1.0" encoding="UTF-8"?>

<odoo noupdate="1">

  <record id="facility_reservation_scheduler_demo_1"
    model="facility.reservation.scheduler">
    <field name="name">Periodic reservation</field>
    <field name="description">
      This reservation is repeated a total of seven times, every two weeks,
      on Monday, Wednesday and Friday.
    </field>
    <field name="date_base"
      eval="(DateTime.today() + timedelta(days=7 - DateTime.today().weekday())).strftime('%Y-%m-%d')"/>
    <field name="time_start" eval="9.0"/>
    <field name="time_stop" eval="11.0"/>
    <field name="weekday_ids" eval="[
        (4, ref('facility_management.facility_weekday_monday'), 0),
        (4, ref('facility_management.facility_weekday_wednesday'), 0),
        (4, ref('facility_management.facility_weekday_friday'), 0)
      ]"/>
    <field name="full_day" eval="False"/>
    <field name="repeat" eval="True"/>
    <field name="interval_number" eval="2"/>
    <field name="interval_type">week</field>
    <field name="finish_type">number</field>
    <field name="finish_number" eval="7"/>
    <field name="facility_id"
      ref="facility_management.facility_classroom_3"/>
    <field name="confirm" eval="True"/>
    <field name="validate" eval="True"/>
    <field name="owner_id" ref="base.user_admin"/>
  </record>

</odoo>
